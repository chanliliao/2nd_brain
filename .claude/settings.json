{
  "env": {
    "PATH": "${HOME}/.cargo/bin:${HOME}/.bun/bin:${HOME}/AppData/Roaming/npm:/c/Program Files/nodejs:/c/Windows/System32:${PATH}"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run_python.sh .claude/hooks/pre-tool-guardrails.py"
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/run_python.sh .claude/hooks/pre-compact-flush.py"
          }
        ]
      }
    ]
  }
}
