    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/c/Users/cliao/Desktop/2nd_Brain/.claude/venv/Scripts/python.exe /c/Users/cliao/Desktop/2nd_Brain/.claude/hooks/session-end-flush.py"
